---
import { withBase } from '../utils/paths';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isExact = (path = '') => pathname === (withBase(path).replace(/\/+$/, '') || '/');
const isWithin = (path: string) => isExact(path) || pathname.startsWith(withBase(`${path}/`));
const navItems = [
  { label: 'Blogs', path: 'blogs', active: isWithin('blogs') || isWithin('posts') },
  { label: 'Tags', path: 'tags', active: isWithin('tags') },
  { label: 'Experiments', path: 'experiments', active: isWithin('experiments') },
];
---

<header class="site-header" data-pond-ui>
  <a class="site-label" href={withBase()} aria-label="トップページ" aria-current={isExact() ? 'page' : undefined}>8`)β</a>
  <div class="header-row">
    <nav class="main-nav" aria-label="メインナビゲーション">
      {navItems.map(({ label, path, active }) => (
        <a href={withBase(`${path}/`)} aria-current={isExact(path) ? 'page' : active ? 'true' : undefined}>{label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="icon-button" href={withBase('search/')} aria-label="記事を検索" title="記事を検索" aria-current={isExact('search') ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      </a>
      <select class="pond-species" data-pond-species aria-label="魚の種類">
        <option value="koi">鯉〈赤〉</option>
        <option value="koi-blue">鯉〈青〉</option>
        <option value="tetra">テトラ</option>
      </select>
    </div>
  </div>
</header>
